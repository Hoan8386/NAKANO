<?xml version = "1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <meta name="title" value="Print RPO (VN)"/>
    <link name="ScvFont" type="font" subtype="opentype" src="${libPdf.font.arial?html}" src-bold="${libPdf.font.arial_bold?html}" src-italic="${libPdf.font.arial_italic?html}" src-bolditalic="${libPdf.font.arial_bolditalic?html}" bytes="2" />
    <style type="text/css">
        ${libPdf.css}

        body {
            font-size: 10pt;
        }
        table { 
            font-size: 10pt;
        }
        table.info-rows td { padding-bottom: 4px; }

        .border-none,
        .border-none td,
        .border-none th {
            border: 0;
        }

         .border-none .top {
            border-top : 1px solid #000;
         }
        
    </style>

</head>
<body padding="0.3in 0.3in 1in 0.3in" size="A4" header-height="0.4in" >
    <#list results.datas as result>
    <table width="100%" >
        <tr>
            <td class="align-center">
                 ${results.headers.tagImgLogo}
            </td>
        </tr>
        <tr>
            <td class="align-center">
                <p> <b>PURCHASE ORDER REQUEST</b></p>
            </td>
        </tr>
        <tr>
            <td class="align-right">
                <p>  ${results.headers.docNum}</p>
            </td>
        </tr>
    </table >

    <table width="100%" class="border-table" border-top="1">

        <tr>
            <td width="50%">
               <table width="100%" class="border-none" >
                    <tr>
                        <td width="30%" >P.J Code:</td>
                        <td width="70%" style=" border-right: none;">${results.headers.pjCode}</td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="50%">Date of Request for PO :</td>
                        <td width="50%" style=" border-right: none;">${results.headers.datePO}</td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="50%">
                 <table width="100%"   class="border-none" >
                    <tr>
                        <td width="30%">P.J Name:</td>
                        <td width="70%" style=" border-right: none;">${results.headers.pjName}</td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                 <table width="100%"  class="border-none">
                    <tr>
                        <td width="50%">Date of Commencement :</td>
                        <td width="50%" style=" border-right: none;">${results.headers.dateCommencement}</td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="30%">Vendor:</td>
                        <td width="70%" style=" border-right: none;">${result.vendor}</td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="50%">Date of Completion :</td>
                        <td width="50%" style=" border-right: none;">${results.headers.dateCompletion}</td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="50%">
                <table width="100%"  class="border-none" style="vertical-align: top; " >
                    <tr >
                        <td width="30%" style=" padding-top: 0;">
                            Scope of Work:
                        </td>
                        <td width="70%" style=" border-right: none; padding-top: 0;">
                            ${results.headers.SCofWork}
                        </td>
                    </tr>
                </table>
            </td>

            <td width="50%" style="padding:0px;">
                <table width="100%" class="border-none" cellpadding="0" cellspacing="0">
                    <tr>
                        <td width="50%" style="margin: 5px " >
                            Maintenance Period :
                        </td>
                        <td width="50%" style="border-right:none; margin: 5px ">
                            ${results.headers.mainPride}
                        </td>
                    </tr>

                    <tr style="border-top:1px solid black;">
                        <td width="50%" style="margin: 5px ">
                            Warranty :
                        </td>
                        <td width="50%" style="border-right:none; margin: 5px  ">
                            ${results.headers.warranty}
                        </td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="30%">Amount:</td>
                        <td width="70%" style=" border-right: none;">
                            <table width="100%"  class="border-none" >
                                <tr>
                                    <td width="30%">${results.headers.currencyDisplay!}</td>
                                    <td width="70%" style=" border-right: none;"> ${result.totalThisAmountDisplay.amount}</td>
                                </tr>
                            </table>
                            
                        </td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                <table width="100%"  class="border-none" >
                    <tr>
                        <td width="50%">Insurance :</td>
                        <td width="50%" style=" border-right: none;">${results.headers.insurance}</td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="30%">Note:</td>
                        <td width="70%" style=" border-right: none;" >${results.headers.note}</td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="50%" style=" border-right: none;">Quotation No.  ${results.headers.quoNo}</td>
                        <td width="50%" style=" border-right: none;">Quotation Dates. :${results.headers.quoDate}</td>
                    </tr>
                </table>
            </td>
        </tr>

        <tr>
            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="30%" style=" border-right: none;">Type of Contract: </td>
                        <td width="70%" style=" border-right: none;" >${results.headers.typeOfCt}</td>
                    </tr>
                </table>
            </td>

            <td width="50%">
                 <table width="100%"  class="border-none" >
                    <tr>
                        <td width="50%" style=" border-right: none;">PO No :</td>
                        <td width="50%" style=" border-right: none;" >${results.headers.poNo}</td>
                    </tr>
                </table>
            </td>
        </tr>

    </table>

    <table width="100%" class="mt-5">
        <tr>
            <td colspan="70">
                Payment term: ${results.headers.paymentTerm}
            </td>
            <td colspan="5"></td>
            <td colspan="25">
                <span style="text-decoration:underline">Attach with:</span>
            </td>
        </tr>

        <tr>
            <td colspan="70">
                - 30% in advance (Exclude VAT) after get bank guarantee
            </td>
            <td colspan="5" align="center">
                <input type="checkbox"
                    readonly="true"
                    name="subcon_quotation"
                    value="${results.headers.subCon}"
                    <#if results.headers.subCon == "true">checked="true"</#if>
                />
            </td>
            <td colspan="25">
                Sub-con Quotation
            </td>
        </tr>

        <tr>
            <td colspan="70">
                - 30% after all materials come to site
            </td>
            <td colspan="5" align="center">
                <input type="checkbox"
                    readonly="true"
                    name="drawing"
                    value="${results.headers.drawings}"
                    <#if results.headers.drawings == "true">checked="true"</#if>
                />
            </td>
            <td colspan="25">
                Drawing (if any)
            </td>
        </tr>

        <tr>
            <td colspan="70">
                - 40% after completion &amp; handover
            </td>
            <td colspan="5" align="center">
                <input type="checkbox"
                    readonly="true"
                    name="schedule"
                    value="${results.headers.schedule}"
                    <#if results.headers.schedule == "true">checked="true"</#if>
                />
            </td>
            <td colspan="25">
                Schedule (if any)
            </td>
        </tr>

        <tr>
            <td colspan="70"></td>
            <td colspan="5" align="center">
                <input type="checkbox"
                    readonly="true"
                    name="others"
                    value="${results.headers.other}"
                    <#if results.headers.other == "true">checked="true"</#if>
                />
            </td>
            <td colspan="25">
                Others...
            </td>
        </tr>

        <tr>
            <td colspan="70"></td>
            <td colspan="5" align="center">
                <input type="checkbox"
                    readonly="true"
                    name="spec"
                    value="${results.headers.specification}"
                    <#if results.headers.specification == "true">checked="true"</#if>
                />
            </td>
            <td colspan="25">
                Spec
            </td>
        </tr>
    </table>

    <table >
        <tr>
            <td colspan="15"> (${results.headers.retention}) Retention</td>
            <td colspan="85">(${results.headers.bankGuarantee}%) Bank Guarantee</td>
        </tr>
    </table>

    <table width="100%" class="border-table">
        <thead>
            <tr height="45px">
                <th colspan="10" align="center">W/B No.</th>
                <th colspan="20" align="center">Working Budget</th>
                <th colspan="20" align="center">This Amount</th>
                <th colspan="20" align="center">Accumulate<br/>Amount</th>
                <th colspan="20" align="center">Balance</th>
                <th colspan="10" align="center">Remarks</th>
            </tr>
        </thead>

        <tbody>
            <#list result.lines as line>
            <tr height="27px">
                <td colspan="10" align="center">
                    ${line.wbNo}
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if line.workingBudget.amount?has_content>
                                    ${line.workingBudget.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${line.workingBudget.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if line.thisAmount.amount?has_content>
                                    ${line.thisAmount.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${line.thisAmount.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if line.accumulateAmount.amount?has_content>
                                    ${line.accumulateAmount.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${line.accumulateAmount.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if line.balance.amount?has_content>
                                    ${line.balance.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${line.balance.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="10">
                    ${line.remarks}
                </td>
            </tr>
        </#list>

            <tr>
                <td colspan="10" align="center">
                    Total
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if result.totalWorkingBudgetDisplay.amount?has_content>
                                    ${result.totalWorkingBudgetDisplay.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${result.totalWorkingBudgetDisplay.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if result.totalThisAmountDisplay.amount?has_content>
                                    ${result.totalThisAmountDisplay.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${result.totalThisAmountDisplay.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if result.totalAccumulateAmountDisplay.amount?has_content>
                                    ${result.totalAccumulateAmountDisplay.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${result.totalAccumulateAmountDisplay.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="20">
                    <table width="100%" class="border-none">
                        <tr>
                            <td width="30%" align="left">
                                <#if result.totalBalanceDisplay.amount?has_content>
                                    ${result.totalBalanceDisplay.currency}
                                </#if>
                            </td>
                            <td width="70%" align="right" style="border-right: none;">
                                ${result.totalBalanceDisplay.amount}
                            </td>
                        </tr>
                    </table>
                </td>

                <td colspan="10"></td>
            </tr>
        </tbody>
    </table>
    <table width="100%" class="border-table mt-5" border-top="1">
        <tr height="50px">
            <td  class="valign-top align-left pl-5" >Remark : ${results.headers.remark}</td>
        </tr>
        <tr height="50px">
            <td class="valign-top align-left pl-5" >Reason of Excess from W/B : ${results.headers.reasonOfExcessFromWB}</td>
        </tr>
        <tr height="50px">
            <td  class="valign-top align-left pl-5">Compensation Proposal :  ${results.headers.compensationProposal}</td>
        </tr>
    </table>

    <table width="100%" class="border-table  mt-5" border-top="1">
        <tr >
            <td colspan="17" align="center"><b>GD</b></td>
            <td colspan="17" align="center"><b>CMS</b></td>
            <td colspan="17" align="center"><b>QS Manager</b></td>
            <td colspan="17" align="center"><b>Admin Manager</b></td>
            <td colspan="17" align="center"><b>Con. Pur. Manager</b></td>
            <td colspan="15" align="center"><b>PM</b></td>
        </tr>
        <tr height="60px">
            <td colspan="17"></td>
            <td colspan="17"></td>
            <td colspan="17"></td>
            <td colspan="17"></td>
            <td colspan="17"></td>
            <td colspan="15"></td>
        </tr>
        <tr height="25px">
            <td colspan="17">Date:</td>
            <td colspan="17">Date:</td>
            <td colspan="17">Date:</td>
            <td colspan="17">Date:</td>
            <td colspan="17">Date:</td>
            <td colspan="15">Date:</td>
        </tr>
    </table>

    <table width="100%" class="border-none  ">
        <tr >
            <td colspan="100" align="center">
                <b><u>NAKANO VIETNAM CO., LTD.</u></b>
            </td>
        </tr>
    </table>
    <#if result_has_next><pbr/></#if>
    </#list>
</body>
</pdf>