<?xml version = "1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <meta name="title" value="Print PO (TH)"/>
    <link name="ScvFont" type="font" subtype="opentype" src="${libPdf.font.arial?html}" src-bold="${libPdf.font.arial_bold?html}" src-italic="${libPdf.font.arial_italic?html}" src-bolditalic="${libPdf.font.arial_bolditalic?html}" bytes="2" />
    <style type="text/css">
        ${libPdf.css}

        body {
            font-size: 10pt;
        }
        table {
            font-size: 10pt;
        }
        .border-none,
        .border-none td,
        .border-none th {
            border: none;
           
        }
    </style>

</head>
<body padding="0.3in 0.5in 0.5in 0.5in" size="A4" >
    <table width="100%">
        <tr>
            <td colspan="25">${result.tagImgLogo}</td>
            <td colspan="75">
                <p style="margin:3px 0" class="fs-12"><b>${subsidiary.legalname}</b></p>
                <p style="margin:3px 0">${subsidiary.mainaddress_text}</p>
                <table class="border-none" style="padding:0px; margin:0px">
                    <tr>
                        <td colspan="40" style="padding:0px; margin:0px">
                            <p>Tel: ${subsidiary.custrecord_scv_sub_tel_phone}</p>
                        </td>
                        <td colspan="40" style="border-right: none; padding:0px; margin:0px">
                            <p>Fax: ${subsidiary.fax}</p>
                        </td>
                        <td colspan="20"></td>
                    </tr>
                </table>
            </td>
        </tr>
        <tr>
            <td colspan="30"></td>
            <td colspan="40">
                <p class="fs-13 align-center"><b>Purchase Order</b></p>
            </td>
            <td colspan="9"><b>PO.No.</b></td>
            <td colspan="21" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.poNumber!""}&nbsp;</p>
            </td>
        </tr>
        <tr  class="mt-3">
            <td colspan="13"><b>Claimant No:</b></td>
            <td colspan="47" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.claimantNo!""}&nbsp;</p>
            </td>
            <td colspan="17"><b>Project Name:</b></td>
            <td colspan="23" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.pjName!""}&nbsp;</p>
            </td>
        </tr>
        <tr  class="mt-3">
            <td colspan="5"><b>To:</b></td>
            <td colspan="55" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.claimantName!""}&nbsp;</p>
            </td>
            <td colspan="6"><b>Date:</b></td>
            <td colspan="34" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.date!""}&nbsp;</p>
            </td>
        </tr>
        <tr  class="mt-3">
            <td colspan="10"><b>Address:</b></td>
            <td colspan="50" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.claimantAddress!""}&nbsp;</p>
            </td>
            <td colspan="8"><b>Tel No.:</b></td>
            <td colspan="32" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.claimantPhone!""}&nbsp;</p>
            </td>
        </tr>
        <tr  class="mt-3">
            <td colspan="26"><b>Refer to your Quotation No:</b></td>
            <td colspan="14" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.quotationNo!""}&nbsp;</p>
            </td>
            <td colspan="7"><b>Dated:</b></td>
            <td colspan="13" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.quotationDate!""}&nbsp;</p>
            </td>
            <td colspan="9"><b>Fax No.:</b></td>
            <td colspan="31" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.claimantFax!""}&nbsp;</p>
            </td>
        </tr>
        ${libPdf.rowcol100}
    </table>
    <p class="align-center">Please supply and despatch the following goods to <b> THAI NAKANO CO., LTD. </b> </p>

    <table width="100%" class="border-table">
        <thead>
            <tr>
                <td colspan="15" class="align-center"><b>Item</b></td>
                <td colspan="12" class="align-center"><b>Quantity</b></td>
                <td colspan="43" class="align-center"><b>Description</b></td>
                <td colspan="15" class="align-center"><b>Unit Price</b></td>
                <td colspan="15" class="align-center"><b>Amount</b></td>
            </tr>
        </thead>
        <tbody>
            <#list result.lines as line>
                <tr>
                    <td colspan="15" class="align-center">${line.item}</td>
                    <td colspan="12" class="align-center">${line.quantity}</td>
                    <td colspan="43">${line.description}</td>
                    <td colspan="15" class="align-right">${line.rate}</td>
                    <td colspan="15" class="align-right">${line.amount}</td>
                </tr>
            </#list>
            <tr>
                <td colspan="70" rowspan="3" style="vertical-align: top; padding: 4px;">
                    <table style="width: 100%; border: none;">
                        <tr>
                            <td style="border: none; padding: 0 0 3px 0;"><b>Remarks :</b></td>
                        </tr>
                        <tr>
                            <td style="border: none; padding: 0 0 2px 10px;">${result.remark}</td>
                        </tr>
                    </table>
                </td>
                <td colspan="15" class="align-right" style="vertical-align: middle; padding: 4px;"><b>Total</b></td>
                <td colspan="15" class="align-right" style="vertical-align: middle; padding: 4px;"><b>${result.totalAmount}</b></td>
            </tr>
            <tr>
                <td colspan="15" class="align-right" style="vertical-align: middle; padding: 4px;"><b>VAT ${result.vatPercent}%</b></td>
                <td colspan="15" class="align-right" style="vertical-align: middle; padding: 4px;">${result.taxAmount}</td>
            </tr>
            <tr>
                <td colspan="15" class="align-right" style="vertical-align: middle; padding: 4px;"><b>Grand Total</b></td>
                <td colspan="15" class="align-right" style="vertical-align: middle; padding: 4px;"><b>${result.grandTotal}</b></td>
            </tr>
        </tbody>
    </table>

    <table width="100%"  class="mt-5">
       <tr class="mt-3">
            <td colspan="18"><b>Terms of Payment</b></td>
            <td colspan="27" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.termsOfPayment!""}&nbsp;</p>
            </td>
            <td colspan="10"></td>
            <td colspan="12"><b>P.M. Name</b></td>
            <td colspan="33" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.pjManager!""}&nbsp;</p>
            </td>
        </tr>
        <tr  class="mt-3">
            <td colspan="18"><b>Place of Delivery</b></td>
            <td colspan="27" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.placeOfDelivery!""}&nbsp;</p>
            </td>
            <td colspan="10"></td>
            <td colspan="25"></td>
            <td colspan="20"></td>
        </tr>
        <tr  class="mt-3">
            <td colspan="17"><b>Date of Delivery</b></td>
            <td colspan="28" style="margin: 0; padding: 0;">
                <p style="width: 100%; margin: 0; padding: 0; border-bottom: 1px dotted #000;">${result.dateOfDelivery!""}&nbsp;</p>
            </td>
            <td colspan="10"></td>
            <td colspan="45">
                <b>For and on behalf of THAI NAKANO CO., LTD.</b>
            </td>
        </tr>
        <tr>
            <td colspan="45">
                <br/>
                <br/>
                <br/>
            </td>
            <td colspan="10"></td>
            <td colspan="45"></td>
        </tr>
         <tr>
            <td colspan="45" class="align-center" style="border-top: 1px dotted #000;">
                <br/>
                <b>Authorized</b>
            </td>
            <td colspan="10"></td>
            <td colspan="45" class="align-center" style="border-top: 1px dotted #000;">
                <br/>
                <b>Ordered by</b>
            </td>
        </tr>
        ${libPdf.rowcol100}
    </table>
</body>
</pdf>
