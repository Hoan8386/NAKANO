<?xml version = "1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <meta name="title" value="Print PO (ID)"/>
    <link name="ScvFont" type="font" subtype="opentype" src="${libPdf.font.arial?html}" src-bold="${libPdf.font.arial_bold?html}" src-italic="${libPdf.font.arial_italic?html}" src-bolditalic="${libPdf.font.arial_bolditalic?html}" bytes="2" />
    <style type="text/css">
        ${libPdf.css}

        body {
            font-size: 10pt;
        }
        table {
            font-size: 10pt;
        }
        .border-none,
        .border-none td,
        .border-none th {
            border: none;
        }
    </style>

</head>
<body padding="0.3in 0.5in 0.5in 0.5in" size="A4" >
   <table border-bottom="1">
        <tr>
            <td colspan="25">${result.tagImgLogo} </td>
            <td colspan="35">
                <p style="margin:3px 0"  class="fs-12"> <b>${subsidiary.legalname} </b></p>
                <p style="margin:3px 0" class="fs-9" >${subsidiary.mainaddress_text}</p>
                 <table class="border-none  " style="padding:0px; margin:0px">
                    <tr class="fs-9">
                        <td style="padding:0px; margin:0px"> 
                            <p> Tel: ${subsidiary.custrecord_scv_sub_tel_phone} </p> 
                        </td>
                        <td style=" border-right: none; padding:0px; margin:0px">
                            <p> Fax: ${subsidiary.fax}</p>
                        </td>
                    </tr>
                </table>
            </td>
            <td colspan="35">
                <table style="width: 100%;">
                    <tr>
                        <td colspan="100" class="align-right fs-8">
                            <b>FORM 1: SUB-CONTRACTOR</b>
                        </td>
                    </tr>
                    <tr height="40px"  class="align-center">
                        <td colspan="100" style=" font-weight:900;"  class=" valign-middle ">
                            <b class="fs-16" >PURCHASE ORDER</b>
                        </td>
                    </tr>
                    ${libPdf.rowcol100}
                </table>
            </td>
        </tr>
   </table>

    <table border-top="1" class="mt-1">
        <tr class="py-3">
            <td> 
                <p class="fs-12">PROJECT: ${result.project}</p>
            </td>
        </tr>
    </table>

    <table>
        <tr>
            <td colspan="60">
                <table class="border-table" border-top="1">
                    <tr>
                        <td><b>SUB-CONTRACTOR'S NAME &amp; ADDRESS</b></td>
                    </tr>
                    <tr>
                        <td>
                            <p><b> ${result.subCon}</b></p>
                            <p>${result.subConAddress}</p>
                            <table class="border-none">
                                <tr>
                                    <td style=" border-right: none;" >
                                        <p>TEL: ${result.subConPhone}</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td><b>ATTENTION:</b> <span>${result.attention}</span></td>
                    </tr>
                </table>
            </td>

            <td colspan="35">
                <table class="border-table" width="100%" border-top="1">
                    <tr>
                        <td colspan="100">
                            <table class="border-none" width="100%">
                                <tr>
                                    <td colspan="35">
                                        <b>Date</b>
                                    </td>
                                    <td colspan="5">
                                        <b>:</b>
                                    </td>
                                    <td colspan="60" style=" border-right: none;">
                                        <p>${result.date}</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="100">
                            <table class="border-none" width="100%">
                                <tr>
                                    <td colspan="35">
                                        <b>P.O. NO.</b>
                                    </td>
                                    <td colspan="5">
                                        <b>:</b>
                                    </td>
                                    <td colspan="60" style=" border-right: none;">
                                        <p>${result.poNumber}</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="100">
                            <table class="border-none" width="100%">
                                <tr>
                                    <td colspan="35">
                                        <b>YOUR REF.</b>
                                    </td>
                                    <td colspan="5">
                                        <b>:</b>
                                    </td>
                                    <td colspan="60" style=" border-right: none;">
                                        <p>${result.yourRef}</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    ${libPdf.rowcol100}
                </table>

                <p class="align-center">(SA 0112)</p>
            </td>
        </tr>
    </table>

   <p> The provision and conditions attached are part of this order which is placed and accepted upon such provisions and conditions. It is also condition of this order that sub-contractor shall follow strictly all attached instructions and specification. </p>

    <table class="border-table"  border-top="1" width="100%">
        <tr>
            <td colspan="100" class="align-center"> 
                <p><b>DESCRIPTION</b></p>
            </td>
        </tr>

        <tr>
            <td colspan="100">
                <table class="border-none" >
                    <tr style="margin-bottom:10px">
                        <td colspan="100" style=" border-right: none;"> 
                            <p class="align-center"> ${result.workItemCode} </p>
                        </td>
                    </tr>

                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>SCOPE OF WORK</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.scopeOfWork}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>CONTRACT PRICE</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.contractPrice.currency} ${result.contractPrice.amount} </p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>VAT (12% x 11/12)</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.vat.currency} ${result.vat.amount}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>TYPE OF CONTRACT</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.typeOfContract}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>DATE OF COMMENCEMENT</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.commencementDate}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>DATE COMPLETION</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.completionDate}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>RETENTION</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.retention}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>INSURANCE</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.insurance}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>WARANTY</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.warranty}</p></td>
                    </tr>
                    <tr>
                        <td colspan="10"></td>
                        <td colspan="35"><p>MAINTENANCE</p></td>
                        <td colspan="2"><p>:</p></td>
                        <td colspan="53" style="border-right: none;"><p>${result.maintenance}</p></td>
                    </tr>
                    <tr class="mt-5 ">
                        <td colspan="10"></td>
                        <td colspan="90" style="border-right: none;">
                            <p class="fs-8">THE CONTRACT PRICE IS SUBJECT TO WITHHOLDING INCOME TAX IN ACCORDANCE WITH THE APPLICABLE TAX REGULATIONS SUPPORTED BY VALID CERTIFICATION</p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table width="100%" class="border-table mt-5"  border-top="1">
        <tr>
            <td colspan="100" class="align-center">
                <p> <b>TERMS OF PAYMENT</b> </p>
            </td>
        </tr>

         <tr>
             <td colspan="100">
                <table width="100%" class="border-none">
                    <tr>
                        <td style=" border-right: none; min-height: 100px;"  >
                            <p style=" margin-left: 30px;">${result.termsOfPayment}</p>
                            <br/>
                            <!-- <p class="fs-8">Please indicate our P.O. number on every of your invoices.</p> -->
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <table class="mt-5" width="100%" border-bottom="1">
        <tr>
            <td colspan="100">
                <p class="fs-12">
                    <b>${subsidiary.legalname}</b>
                </p>
            </td>
        </tr>

        <tr height="80px">
            <td colspan="100"></td>
        </tr>

        <tr class="mb-2">
            <td colspan="30" style="border-bottom: 1px solid black;">
            </td>

            <td colspan="3">
            </td>

            <td colspan="2"></td>

            <td colspan="33" style="border-bottom: 1px dotted black;">
            </td>

            <td colspan="2"></td>

            <td colspan="30" style="border-bottom: 1px dotted black;">
            </td>
        </tr>

        <tr>
            <td colspan="33">
                <p class="fs-12" >
                    PRESIDENT DIRECTOR
                </p>
            </td>

            <td colspan="2"></td>

            <td colspan="33">
                <p >
                    COMPANY'S CHOP &amp; SIGN
                </p>
            </td>

            <td colspan="2"></td>

            <td colspan="30">
                <p >
                    DATE
                </p>
            </td>
        </tr>
    </table>

    <table class="mt-1"  width="100%" border-top="1">
        <tr>
            <td  class="align-right">
                <p>
                    Note : Please endorse, sign and return us the duplicate copy
                </p>
            </td>

            
        </tr>

        <tr>
            

            <td class="align-right" >
                <p>
                    FRM/PCH/08/03/24
                </p>
            </td>
        </tr>
    </table>
   
</body>
</pdf>
