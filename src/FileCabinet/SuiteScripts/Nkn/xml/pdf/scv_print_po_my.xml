<?xml version = "1.0"?><!DOCTYPE pdf PUBLIC "-//big.faceless.org//report" "report-1.1.dtd">
<pdf>
<head>
    <meta name="title" value="Print PO (MY)"/>
    <link name="ScvFont" type="font" subtype="opentype" src="${libPdf.font.arial?html}" src-bold="${libPdf.font.arial_bold?html}" src-italic="${libPdf.font.arial_italic?html}" src-bolditalic="${libPdf.font.arial_bolditalic?html}" bytes="2" />
    <style type="text/css">
        ${libPdf.css}

        body {
            font-size: 9pt;
        }
        table {
            font-size: 9pt;
        }
        .border-none,
        .border-none td,
        .border-none th {
            border: none;
        }
       
    </style>
</head>
<body padding="0.3in 0.5in 0.5in 0.5in" size="A4" >
    <table style="width: 100%;" class="mb-10">
       <tr >
            <td colspan="25" valign="middle" align="left">
                ${result.tagImgLogo}
            </td>
            <td colspan="50" valign="middle" style = "margin-top:22px">
                <p style="margin: 0; padding: 0;" class="fs-14 align-right">
                    <b>${subsidiary.legalname}</b>
                </p>
                <p style="margin: 0; padding: 0;" class="align-right">
                    199101009281 (219594-W)
                </p>
            </td>
            <td colspan="25" valign="middle"></td>
        </tr>
        <tr>
            <td colspan="100">
                <p  class="align-center fs-10"  > <b border-bottom="1" >PURCHASE ORDER (KL) </b></p>
            </td>
        </tr>
         ${libPdf.rowcol100}
    </table>

    <table style="width: 100%;" >
        <tr>
            <td colspan="50">
                <table style="width: 100%;" >
                    <tr>
                        <td colspan="10">M/S</td>
                        <td colspan="5">:</td>
                        <td colspan="35" border-bottom="1">${result.vendorName}</td>
                    </tr>

                    <tr>
                        <td colspan="10"></td>
                        <td colspan="5"></td>
                        <td colspan="35" border-bottom="1">
                           ${result.vendorAddress}
                        </td>
                    </tr>

                    <tr>
                        <td colspan="10">ATTN</td>
                        <td colspan="5">:</td>
                        <td colspan="35" border-bottom="1">${result.attention}</td>
                    </tr>

                    <tr>
                        <td colspan="10">TEL</td>
                        <td colspan="5">:</td>
                        <td colspan="35" border-bottom="1">${result.vendorPhone}</td>
                    </tr>

                    <tr>
                        <td colspan="10">FAX</td>
                        <td colspan="5">:</td>
                        <td colspan="35" border-bottom="1">${result.vendorFax}</td>
                    </tr>

                    <tr>
                        <td colspan="10">E-MAIL</td>
                        <td colspan="5">:</td>
                        <td colspan="35" border-bottom="1">${result.vendorEmail}</td>
                    </tr>

                    <tr>
                        <td >
                            <br/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="20">CONTRACT PRICE</td>
                        <td colspan="5">:</td>
                        <td colspan="25" border-bottom="1">
                            <b>
                             ${result.contactPriceDisplay.currency}&nbsp;${result.contactPriceDisplay.amount}
                            </b>
                        </td>
                    </tr>
                     ${libPdf.rowcol100}
                </table>
            </td>

            <td colspan="50">
                <table style="width: 100%;">
                    <tr>
                        <td colspan="25" ><p class="align-right">PJ NAME</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.project}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">PJ CODE</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.projectId}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">DATE</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.date}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">P.O. NO</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.poNumber}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">OUR REF</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.ourRef}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">YOUR REF</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.yourRef}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">COMMENCEMENT DATE</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.commencementDate}</p></td>
                    </tr>

                    <tr>
                        <td colspan="25" ><p class="align-right">COMPLETION DATE</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.completionDate}</p></td>
                    </tr>
                    <tr>
                        <td >
                            <br/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="25" ><p class="align-right">TYPE OF CONTRACT</p></td>
                        <td colspan="5">:</td>
                        <td colspan="20" border-bottom="1"><p>${result.typeOfContract}</p></td>
                    </tr>
                     ${libPdf.rowcol100}
                </table>
            </td>
        </tr>

        <tr border-bottom="1" class="mt-10">
            <td colspan="100">
                <p >The provision and the attached conditions shall form part of this order.</p>
            </td>
        </tr>
         ${libPdf.rowcol100}
    </table>

    <table width="100%" class="mt-10">
        <tr>
            <td colspan="100">
                <b border-bottom="1">PLACE OF DELIVERY :</b>
            </td>
        </tr>
        <tr>
            <td colspan="100">
                ${result.placeOfDelivery}
            </td>
        </tr>
        <tr class="mt-5">
            <td colspan="100">
                <b border-bottom="1">TERMS OF PAYMENT :</b>
            </td>
        </tr>
        <tr>
            <td colspan="100">
                ${result.termsOfPayment}
            </td>
        </tr>
        <tr class="mt-5">
            <td colspan="100">
                <b border-bottom="1">REMARKS :</b>
            </td>
        </tr>
        <tr>
            <td colspan="100">
                ${result.remark}
            </td>
        </tr>
        <tr class="mt-5">
            <td colspan="100">
                <b border-bottom="1">DESCRIPTION :</b>
            </td>
        </tr>
        <tr>
            <td colspan="100">
                <#list result.lines as line>
                    ${line.workItemCode} &nbsp;&nbsp;&nbsp;&nbsp; = &nbsp;&nbsp;&nbsp;&nbsp;
                    ${line.currency}&nbsp;${line.amount}
                    <br/>
                </#list>
            </td>
        </tr>
    </table>

    <table width="100%" page-break-inside="avoid" >
        <tr class="mt-5">
            <td colspan="100">
                <b>${subsidiary.legalname}</b><br/>
                199101009281 (219594-W)
            </td>
        </tr>
        <tr height="70px">
            <td colspan="30" style="border-bottom: 1px dotted #000;"></td>
            <td colspan="35"></td>
            <td colspan="35"></td>
        </tr>
        <tr class="mt-5" border-bottom="1">
            <td colspan="100">
                <b>AUTHORISED SIGNATURE:</b>
            </td>
        </tr>
        <tr class="mt-5">
            <td colspan="100">
                I,
                <table style="width: 25%; display: inline;">
                    <tr>
                        <td border-bottom="1"></td>
                    </tr>
                </table>
                of
                <b>${result.vendorName}</b>
                hereby accept the abovementioned terms and conditions of this purchase order.
            </td>
        </tr>
        <tr>
            <td colspan="100">
                <br/>
            </td>
         </tr>
        <tr>
           
            <td colspan="55">
                <table style="width: 100%;">
                    <tr>
                        <td style="border-bottom: 1px dotted #000;"></td>
                    </tr>
                </table>
            </td>
            <td colspan="10"></td>
            <td colspan="35">
                NRIC: 981112-07-5443
            </td>
        </tr>
        <tr>
            <td colspan="100">
                Signature
            </td>
        </tr>
    </table>

    <table width="100%">
        <tr border-top="1" class="mt-5">
            <td colspan="30" class="mt-2">
                <b>Kuala Lumpur Head Office :</b><br/>
                Block B, 15-42, Megan Park,<br/>
                Jalan 1/125-E, Taman Desa Petaling,<br/>
                57100 Kuala Lumpur, Malaysia.<br/>
                Tel: 03-9050 6977&nbsp;&nbsp;Fax: 03-9059 6277<br/>
                Email: klhq@nakano-const.com
            </td>
            <td colspan="5"></td>
            <td colspan="30" class="mt-2">
                <b>Johor Bahru Office :</b><br/>
                12A &amp; 14A, Jalan Bertam 14,<br/>
                Taman Daya,<br/>
                81100 Johor Bahru, Johor, Malaysia.<br/>
                Tel: 07-354 6461, 354 6462&nbsp;&nbsp;Fax: 07-354 6463<br/>
                Email: johor@nakano-const.com
            </td>
            <td colspan="5"></td>
            <td colspan="30" class="mt-2">
                <b>Penang Office :</b><br/>
                345, J, 2nd Floor, Bangunan Kelab Gelugor,<br/>
                Jalan Sultan Azlan Shah,<br/>
                11700 Penang, Malaysia.<br/>
                Tel: 04-657 0839, 657 7146&nbsp;&nbsp;Fax: 04-657 4505<br/>
                Email: penang@nakano-const.com
            </td>
        </tr>
        ${libPdf.rowcol100}
    </table>
</body>
</pdf>
